{
  "crons": [
    {
      "path": "/api/report-daily",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/report-monthly",
      "schedule": "0 19 1 * *"
    },
    {
      "path": "/api/cron-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}